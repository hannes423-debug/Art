{
  "name": "art",
  "version": "0.1.0",
  "private": true,
  "description": "Art — a free, open-source, offline-capable raster and sprite editor for desktop and mobile browsers.",
  "keywords": [
    "pixel-art",
    "sprite-editor",
    "image-editor",
    "drawing",
    "pwa",
    "offline",
    "game-art"
  ],
  "homepage": "https://github.com/hannes423-debug/Art",
  "bugs": {
    "url": "https://github.com/hannes423-debug/Art/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hannes423-debug/Art.git"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "icons": "node scripts/generate-icons.mjs",
    "format": "prettier --write \"src/**/*.{ts,css,js}\" \"tests/**/*.ts\" \"*.ts\" \"scripts/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.{ts,css,js}\" \"tests/**/*.ts\" \"*.ts\" \"scripts/*.mjs\""
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "^22.20.5",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
